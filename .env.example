# Port the server runs on
PORT=3000

# Optional: fill these in if you want an email sent for every new
# appointment request. If left blank, submissions are still saved
# to data/appointments.json, just without an email notification.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=heartbeat@gmail.com

# Token required to view /api/appointments (change this!)
ADMIN_TOKEN=changeme
